{
  "name": "custom-x-following-feed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"next dev -H 127.0.0.1\" \"pnpm worker\"",
    "dev:web": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c blue,magenta \"next start -H 127.0.0.1\" \"pnpm worker\"",
    "worker": "tsx src/worker.ts",
    "sync": "tsx src/worker.ts --once",
    "test": "vitest run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rettiwt-api": "7.1.3",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "x-client-transaction-id": "^0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.1"
}
